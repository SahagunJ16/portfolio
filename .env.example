# Portfolio data: full URL of the JSON file in Vercel Blob (private store).
# Create a Blob store in Vercel, upload your data.json, then paste the blob URL here.
# Example: https://xxxxx.private.blob.vercel-storage.com/data.json
PORTFOLIO_DATA_URL=

# Vercel sets BLOB_READ_WRITE_TOKEN automatically when the Blob store is linked to the project.
# For local dev, you can add it here after copying from Vercel Dashboard → Storage → your store → .env.
# BLOB_READ_WRITE_TOKEN=
